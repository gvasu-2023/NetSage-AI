      "destination": "192.168.20.10",
      "result": "failure"
    },
    {
      "source": "PC1",
      "destination": "192.168.30.10",
      "result": "failure"
    },
    {
      "source": "PC1",
      "destination": "172.16.10.10",
      "result": "failure"
    }
  ],

  "show_outputs": {
