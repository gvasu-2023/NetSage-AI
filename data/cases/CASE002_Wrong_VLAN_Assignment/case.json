      "subnet_mask": "255.255.255.0",
      "configured_default_gateway": "192.168.20.1",
      "correct_default_gateway": "192.168.20.1",
      "expected_vlan": 20
    },

    "SW1": {
      "faulty_interface": "Fa0/2",
      "actual_vlan": 10,
      "expected_vlan": 20,
      "interface_status": "up"
    }
  },

  "connectivity_tests": [
    {
      "source": "PC2",
      "destination": "192.168.20.1",
      "result": "failure"
    },
    {
      "source": "PC2",
      "destination": "192.168.10.10",
      "result": "failure"
    },
    {
      "source": "PC2",
      "destination": "192.168.30.10",
      "result": "failure"
    }
  ],

  "show_outputs": {
    "ipconfig": {
      "ip_address": "192.168.20.10",
      "subnet_mask": "255.255.255.0",
      "default_gateway": "192.168.20.1"
    },

    "show_vlan_brief": {
      "Fa0/1": {
        "vlan": 10,
        "name": "USERS"
      },
      "Fa0/2": {
        "vlan": 10,
        "name": "USERS"
      },
      "Fa0/3": {
        "vlan": 30,
        "name": "SERVERS"
      }
    },

    "show_interfaces_fa0_2_switchport": {
      "administrative_mode": "static access",
      "operational_mode": "static access",
      "access_mode_vlan": 10,
      "access_mode_vlan_name": "USERS"
    }
  },

  "expected_fault": "SW1 interface Fa0/2 is assigned to VLAN 10, but PC2 belongs to VLAN 20.",

  "faulty_device": "SW1",

  "faulty_interface": "Fa0/2",

  "actual_vlan": 10,

  "expected_vlan": 20,

  "osi_layer": "Layer 2",

  "concept": "VLAN Assignment",

  "severity": "High",

  "expected_next_command": "show vlan brief",

  "expected_fix": {
    "device": "SW1",
    "interface": "Fa0/2",
    "parameter": "Access VLAN",
    "incorrect_value": 10,
    "correct_value": 20,
    "configuration": [
      "enable",
      "configure terminal",
      "interface fa0/2",
      "switchport access vlan 20"
    ]
  },

  "verification": [
    "Run show vlan brief and verify Fa0/2 is assigned to VLAN 20.",
    "Run show interfaces fa0/2 switchport.",
    "Ping 192.168.20.1 from PC2.",
    "Ping 192.168.10.10 from PC2.",
    "Ping 192.168.30.10 from PC2."
  ],

  "rule_checker_findings": [
    "PC2 Layer 3 configuration is valid.",
    "PC2 cannot reach its configured default gateway.",
    "SW1 Fa0/2 access VLAN does not match the expected VLAN for PC2.",
    "The switch port is configured in VLAN 10 while PC2 belongs to VLAN 20."
  ],

