{
  "case_id": "CASE002",
  "category": "VLAN",
  "title": "Wrong VLAN Assignment",
  "symptom": "PC2 has a valid IP address and default gateway configuration but cannot reach its gateway or communicate with devices in other networks.",
  "topology": "PC2 -> SW1 -> R1 -> R2 -> External-PC",

  "device_configs": {
    "PC2": {
